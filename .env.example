# Which content source to build against. Default is `local` (bundled JSON in
# src/content/data). Switch to `sanity` or `strapi` once a CMS is stood up —
# no code changes, only these variables.
VITE_CMS=local

# --- Sanity (VITE_CMS=sanity) ---
# VITE_SANITY_PROJECT_ID=
# VITE_SANITY_DATASET=production
# VITE_SANITY_API_VERSION=2024-10-01

# --- Strapi (VITE_CMS=strapi) ---
# VITE_STRAPI_URL=https://cms.example.gov
# VITE_STRAPI_TOKEN=            # read-only token; omit if the API is public

# --- Hosting ---
# These three are read by vite.config.ts, which Vite doesn't give .env files to, so
# setting them here does nothing. Set them in the shell when you build; README.md
# → Hosting has the commands.
#
# VITE_BASE_PATH=/firehouse/   the sub-path the site is served from
# VITE_SITE_URL=https://gsl.noaa.gov   absolute origin for the og:image link preview
# VITE_NOINDEX=1               for a copy that isn't the public site

# --- Local WordPress (docker-compose.yml, bin/wp-init) ---
# Where the NOAA-GSL/gsl-wordpress checkout is, and the port for http://localhost:<port>.
# GSL_WORDPRESS_DIR=../wordpress-gsl
# FIREHOUSE_WP_PORT=8090
# bin/wp-init also writes GSL_WORDPRESS_IMAGE and GSL_WPCLI_IMAGE here, read from that
# checkout, so GSL's exact versions stay out of this public repository.
