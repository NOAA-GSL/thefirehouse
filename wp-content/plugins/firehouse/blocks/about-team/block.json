{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "firehouse/about-team",
	"title": "Firehouse About team",
	"category": "widgets",
	"description": "Who is behind the hub: the section's words, the team's mailbox, and a card for each member with a portrait from the Media Library.",
	"textdomain": "firehouse",
	"parent": [
		"firehouse/about-sections"
	],
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"body": {
			"type": "string",
			"default": ""
		},
		"emailLead": {
			"type": "string",
			"default": ""
		},
		"email": {
			"type": "string",
			"default": ""
		},
		"members": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"multiple": false,
		"reusable": false
	},
	"render": "file:./render.php"
}
