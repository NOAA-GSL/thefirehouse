{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "firehouse/about-mission",
	"title": "Firehouse About mission",
	"category": "widgets",
	"description": "Why the hub exists: a heading and its paragraphs.",
	"textdomain": "firehouse",
	"parent": [
		"firehouse/about-sections"
	],
	"attributes": {
		"heading": {
			"type": "string",
			"default": ""
		},
		"paragraphs": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"multiple": false,
		"reusable": false
	},
	"render": "file:./render.php"
}
