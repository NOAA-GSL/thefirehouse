{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "firehouse/about-audiences",
	"title": "Firehouse About audiences",
	"category": "widgets",
	"description": "Who the hub serves: the section's words and a card for each audience, with its icon.",
	"textdomain": "firehouse",
	"parent": [
		"firehouse/about-sections"
	],
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"body": {
			"type": "string",
			"default": ""
		},
		"items": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"multiple": false,
		"reusable": false
	},
	"render": "file:./render.php"
}
