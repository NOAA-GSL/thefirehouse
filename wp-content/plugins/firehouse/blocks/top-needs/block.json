{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "firehouse/top-needs",
	"title": "FireHouse top needs",
	"category": "widgets",
	"description": "The landing page's top needs: a card for each topic area with its first needs, the synthesis note, and where the needs come from.",
	"textdomain": "firehouse",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": ""
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"body": {
			"type": "string",
			"default": ""
		},
		"needsPerCard": {
			"type": "integer",
			"default": 5
		}
	},
	"supports": {
		"html": false,
		"inserter": false,
		"multiple": false,
		"reusable": false
	},
	"render": "file:./render.php"
}
