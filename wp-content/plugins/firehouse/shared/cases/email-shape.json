{
  "$comment": "Cases for shared/email-shape.json. `email` is whether the text holds something shaped like an email address; `team` is whether the whole text is a team work address, the one kind of email the site shows on purpose. The last two `email` cases are known limits: the check catches an address written out, which is how a submitter's email would arrive, not one disguised on purpose. `find` cases give content blocks and the paths a scan reports in them, in any order.",
  "cases": [
    { "name": "an address", "text": "jane.doe@noaa.gov", "email": true, "team": true },
    { "name": "an address in a sentence, in capitals", "text": "Contact Jane.Doe@NOAA.GOV for the data.", "email": true, "team": false },
    { "name": "a mailto link", "text": "mailto:jane@example.org", "email": true, "team": false },
    { "name": "an address in angle brackets", "text": "Jane <jane@example.org>", "email": true, "team": false },
    { "name": "an address after a label", "text": "Email:x@y.gov", "email": true, "team": false },
    { "name": "an address outside NOAA", "text": "jane@gmail.com", "email": true, "team": false },
    { "name": "a team address with another after it", "text": "jane@noaa.gov; bob@gmail.com", "email": true, "team": false },
    { "name": "a team address with a line break after it", "text": "jane@noaa.gov\n", "email": true, "team": false },
    { "name": "a handle in a link", "text": "https://medium.com/@name.surname/post", "email": false, "team": false },
    { "name": "a handle on its own", "text": "Follow @firewx for updates.", "email": false, "team": false },
    { "name": "no domain ending", "text": "a@b", "email": false, "team": false },
    { "name": "a DOI", "text": "https://doi.org/10.1175/WAF-D-24-0001.1", "email": false, "team": false },
    { "name": "a spaced address isn't caught", "text": "jane @ noaa.gov", "email": false, "team": false },
    { "name": "a spelled-out address isn't caught", "text": "jane at noaa dot gov", "email": false, "team": false }
  ],
  "find": [
    { "name": "the team's address in its own field passes", "blocks": { "about": { "team": { "email": "the.team@noaa.gov" } } }, "paths": [] },
    { "name": "text with no address passes", "blocks": { "settings": { "footerBlurb": "A project of GSL." } }, "paths": [] },
    { "name": "an outside address in the team's field", "blocks": { "about": { "team": { "email": "the.team@gmail.com" } } }, "paths": ["about.team.email"] },
    { "name": "a sentence in the team's field", "blocks": { "about": { "team": { "email": "Write to the.team@noaa.gov" } } }, "paths": ["about.team.email"] },
    { "name": "a NOAA address in a project", "blocks": { "projects": [{ "abstract": "Write to jane@noaa.gov." }, { "contact": "jane@noaa.gov" }] }, "paths": ["projects.0.abstract", "projects.1.contact"] },
    { "name": "a team member's own address", "blocks": { "about": { "team": { "members": [{ "name": "A", "email": "a.person@noaa.gov" }] } } }, "paths": ["about.team.members.0.email"] },
    { "name": "a NOAA address in the disclaimer", "blocks": { "settings": { "disclaimer": "jane@noaa.gov" } }, "paths": ["settings.disclaimer"] },
    { "name": "a key that spells the team's field", "blocks": { "about": { "team.email": "d@noaa.gov" } }, "paths": ["about.team.email"] },
    { "name": "the team's field as a list", "blocks": { "about": { "team": { "email": ["the.team@noaa.gov"] } } }, "paths": ["about.team.email.0"] },
    { "name": "the team's field holding an object", "blocks": { "about": { "team": { "email": { "address": "the.team@noaa.gov" } } } }, "paths": ["about.team.email.address"] },
    { "name": "the team's field anywhere else", "blocks": { "landing": { "team": { "email": "the.team@noaa.gov" } }, "about": { "about": { "team": { "email": "the.team@noaa.gov" } } } }, "paths": ["landing.team.email", "about.about.team.email"] }
  ]
}
