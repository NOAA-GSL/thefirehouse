<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="wp-content/plugins/firehouse/tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true">
  <testsuites>
    <testsuite name="Firehouse plugin">
      <directory>wp-content/plugins/firehouse/tests</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory suffix=".php">wp-content/plugins/firehouse</directory>
    </include>
    <exclude>
      <directory>wp-content/plugins/firehouse/tests</directory>
    </exclude>
  </source>
</phpunit>
